# ===== KhanijSetu Backend Configuration =====
# Copy this file to .env and fill in the values

# Database — MySQL/MariaDB (XAMPP local) or PostgreSQL (production)
# XAMPP MariaDB (binds to IPv6 on Windows):
DATABASE_URL=mysql+pymysql://root:@[::1]:3306/khanijsetu
# Standard MySQL/MariaDB:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/khanijsetu
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/khanijsetu
# SQLite (legacy):
# DATABASE_URL=sqlite:///./khanijsetu.db

# JWT Secret — CHANGE THIS IN PRODUCTION (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment — development | production
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.pdf,.jpg,.jpeg,.png

# AI Service (optional — system works without it)
AI_API_KEY=
AI_API_URL=

# OCR (optional)
TESSERACT_PATH=
